{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codex \u989d\u5ea6\u60ac\u6d6e\u7a97",
  "mainBinaryName": "CodexQuotaWindow",
  "version": "1.0.2",
  "identifier": "com.codex.quota-floating-window",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex \u989d\u5ea6\u60ac\u6d6e\u7a97",
        "width": 116,
        "height": 116,
        "minWidth": 96,
        "minHeight": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5RkQzOUM1NDFENzIyRTUKUldUbEl0ZEJ4VG45K1YzVXhtaWQyWHh6SFB0N1dCc05BVGtlNXhqdU5pdHJDejV1eXFUSXNJWU4K",
      "endpoints": [
        "https://github.com/nf2huochao/Codex-QuotaOrb/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
